{
  "name": "personal-website-solid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "start": "bun run build && vp preview",
    "commit": "bunx cz --hook || true",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "bun run types && bun run lint && bun run format:check",
    "types": "tsc -b",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@motionone/dom": "^10.18.0",
    "@solid-primitives/i18n": "^3.0.0",
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "@voidzero-dev/vite-plus-core": "8.3.8000",
    "ogl": "^1.0.11",
    "solid-js": "^2.0.0"
  },
  "devDependencies": {
    "@montanaaq/ts-config": "^0.1.1",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/node": "^26.6.6",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  }
}
