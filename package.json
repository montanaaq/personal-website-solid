{
  "name": "personal-website-solid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "start": "bun run build && vp preview",
    "commit": "bunx cz --hook || true",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "bun run types && bun run lint && bun run format:check",
    "types": "tsc -b"
  },
  "dependencies": {
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "ogl": "^1.0.11",
    "solid-js": "^1.9.15",
    "solid-motionone": "^1.0.4",
    "solid-sonner": "^0.3.2"
  },
  "devDependencies": {
    "@montanaaq/ts-config": "^0.1.1",
    "@types/node": "^26.5.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "0.3.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  }
}
